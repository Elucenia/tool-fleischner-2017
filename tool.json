{
  "tool": {
    "id": "fleischner-2017",
    "title": "Fleischner 2017 (nódulo pulmonar sólido)",
    "short": "Seguimento do nódulo pulmonar incidental na TC",
    "desc": "Recomendações da Sociedade Fleischner 2017 para nódulo pulmonar sólido incidental na TC: seguimento conforme tamanho, número e risco.",
    "lead": "Indica o seguimento de nódulos pulmonares sólidos encontrados por acaso na tomografia de adultos com 35 anos ou mais, conforme o tamanho, o número de nódulos e o risco do paciente.",
    "kind": "Calculadora",
    "spec": [
      "radiologia-e-diagnostico-por-imagem",
      "pneumologia",
      "cirurgia-toracica",
      "cirurgia-oncologica"
    ],
    "fields": [
      [
        "tamanho",
        "Diâmetro médio do nódulo (mais suspeito, se múltiplos)",
        "num",
        {
          "min": 1,
          "max": 30,
          "step": 0.1,
          "unit": "mm",
          "ph": "7"
        }
      ],
      [
        "num",
        "Número de nódulos",
        "radio",
        {
          "opts": {
            "u": "Único",
            "m": "Múltiplos"
          }
        }
      ],
      [
        "risco",
        "Risco de câncer de pulmão",
        "radio",
        {
          "opts": {
            "b": "Baixo",
            "a": "Alto (tabagismo, idade, exposição, história familiar, enfisema, lobo superior)"
          }
        }
      ]
    ],
    "formula": "<p>Diâmetro médio = (maior eixo + menor eixo) ÷ 2, arredondado para o milímetro mais próximo. Faixas: &lt; 6 mm (&lt; 100 mm³), 6 a 8 mm (100 a 250 mm³) e &gt; 8 mm (&gt; 250 mm³).</p>",
    "sources": [
      [
        "MacMahon H et al. Guidelines for management of incidental pulmonary nodules detected on CT images: from the Fleischner Society 2017. Radiology, 2017.",
        "https://doi.org/10.1148/radiol.2017161659"
      ],
      [
        "MacMahon et al. Radiology2017, DOI10.1148/radiol.2017161659",
        "https://pubs.rsna.org/doi/full/10.1148/radiol.2017161659"
      ],
      [
        "Original sixteen-page RSNA article, institutional copy at University of Wisconsin",
        "https://wiki.radiology.wisc.edu/images/b/b9/Flesichner_Guidelines_2017.pdf"
      ]
    ],
    "cases": [
      [
        "Único de 4 mm, baixo risco: sem seguimento",
        {
          "tamanho": 4,
          "num": "u",
          "risco": "b"
        },
        {
          "level": "low",
          "verdict": "Sem seguimento de rotina"
        }
      ],
      [
        "Corte: 5,6 mm arredonda para 6 mm, único, alto risco: TC em 6–12 meses",
        {
          "tamanho": 5.6,
          "num": "u",
          "risco": "a"
        },
        {
          "raw": {
            "mm": 6
          },
          "level": "mid",
          "verdict": "TC em 6 a 12 meses e depois em 18 a 24 meses"
        }
      ],
      [
        "Múltiplos, maior de 7 mm, baixo risco: TC em 3–6 meses",
        {
          "tamanho": 7,
          "num": "m",
          "risco": "b"
        },
        {
          "level": "mid",
          "verdict": "TC em 3 a 6 meses; depois, considerar"
        }
      ],
      [
        "Único de 10 mm, baixo risco: TC em 3 meses, PET-TC ou biópsia",
        {
          "tamanho": 10,
          "num": "u",
          "risco": "b"
        },
        {
          "level": "high",
          "verdict": "PET-TC"
        }
      ]
    ],
